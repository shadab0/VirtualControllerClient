<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ControllerPlayActivity">

    <!-- Main Content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/playActivityMainContent"
        android:background="@color/black"
        android:splitMotionEvents="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="UselessLeaf,SpeakableTextPresentCheck" />

        <LinearLayout
            android:id="@+id/record_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <androidx.cardview.widget.CardView
                android:id="@+id/record_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="30dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/start_record"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@null"
                    android:scaleType="fitXY"
                    android:layout_marginEnd="5dp"
                    android:src="@mipmap/record"
                    app:tint="#FF0000"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/stop_record"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@null"
                    android:scaleType="fitXY"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:src="@mipmap/stop"
                    app:tint="#FF0000"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

                <ImageButton
                    android:id="@+id/live"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@null"
                    android:scaleType="fitXY"
                    android:layout_marginStart="5dp"
                    android:src="@mipmap/live"
                    app:tint="#888888"
                    tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

            </LinearLayout>

            </androidx.cardview.widget.CardView>

            <ImageButton
                android:id="@+id/expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@null"
                android:src="@drawable/down"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Side Panel (Drawer) -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E0E0E0"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings (Swipe to close ->)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="#000000"/>

        <Switch
            android:id="@+id/switch_gyro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Gyroscope"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_gyro_sens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gyro Sensitivity"
            android:textColor="#000000"/>
        <SeekBar
            android:id="@+id/seekbar_gyro_sens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5000"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_gyro_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gyro Anti-Deadzone"
            android:textColor="#000000"/>
        <SeekBar
            android:id="@+id/seekbar_gyro_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32767"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_touch_sens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch Sensitivity"
            android:textColor="#000000"/>
        <SeekBar
            android:id="@+id/seekbar_touch_sens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5000"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tv_touch_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch Anti-Deadzone"
            android:textColor="#000000"/>
        <SeekBar
            android:id="@+id/seekbar_touch_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32767"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>