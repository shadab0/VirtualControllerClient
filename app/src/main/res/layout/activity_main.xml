<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF303030">

    <TextView
        android:id="@+id/textView"
        android:layout_width="344dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal" />

    <androidx.cardview.widget.CardView
        android:id="@+id/settings_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        app:cardBackgroundColor="#ffe795"
        app:cardCornerRadius="23dp"
        app:cardElevation="4dp">

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:padding="10dp"
            android:src="@drawable/settings"
            app:tint="#403a25"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/settings_card"
        android:layout_marginStart="50dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="50dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:backgroundTint="#ffe795"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:text="Connect"
                android:textColor="#403a25"
                app:cornerRadius="25dp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/create_macro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#ffe795"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:text="Create Macro"
                android:textColor="#403a25"
                app:cornerRadius="25dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="#ffe795"
                android:text="play"
                android:textColor="#403a25"
                android:textSize="25sp"
                app:cornerRadius="50dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/set_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:backgroundTint="#ffe795"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:text="Set Layout"
                android:textColor="#403a25"
                app:cornerRadius="25dp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/set_macro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#ffe795"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:text="Set Macro"
                android:textColor="#403a25"
                app:cornerRadius="25dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        app:cardBackgroundColor="#552624"
        app:cardCornerRadius="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="10dp"
            android:drawablePadding="15dp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:text="Please disable 'Swipe to Screenshot' gesture while using this app."
            android:textColor="#EA4335"
            app:drawableLeftCompat="@drawable/info"
            tools:ignore="HardcodedText" />


    </androidx.cardview.widget.CardView>

</RelativeLayout>